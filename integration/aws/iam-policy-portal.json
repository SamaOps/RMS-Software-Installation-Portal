{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PortalManagesInstallerObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::rms-softwares/softwares/*"
    },
    {
      "Sid": "HeadObjectReturns404InsteadOf403",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::rms-softwares",
      "Condition": { "StringLike": { "s3:prefix": ["softwares/*"] } }
    }
  ]
}
