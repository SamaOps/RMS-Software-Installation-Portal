# =============================================================================
# RMS Software Portal — configuration
# Every value below is optional unless marked REQUIRED. Defaults are shown.
# =============================================================================

# ---- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=production
# Origin(s) of the admin UI (comma-separated). Leave empty when the API serves the built UI itself.
CORS_ORIGIN=

# ---- Database (the EXISTING RMS PostgreSQL) ---------------------------------
# REQUIRED
DATABASE_URL=postgres://rms_portal:CHANGE_ME@db-host:5432/rms
# RDS usually needs SSL
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# ---- Auth -------------------------------------------------------------------
# REQUIRED. openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_TTL=8h
BCRYPT_COST=12
ADMIN_PASSWORD_MIN_LENGTH=10
# REQUIRED. Comma-separated "username:bcryptHash". Generate: npm run hash-password -- <user> '<strong-password>'
ADMIN_USERS=
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX=20

# ---- Object storage ---------------------------------------------------------
# AWS S3:          leave S3_ENDPOINT empty, set S3_REGION (e.g. ap-south-1)
# Cloudflare R2:   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  S3_REGION=auto
# MinIO:           S3_ENDPOINT=http://minio:9000  S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=ap-south-1
# REQUIRED
S3_BUCKET=rms-softwares
# Omit both keys on EC2 to use the instance IAM role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Objects are stored at <bucket>/<prefix><file_name>. Keep the trailing slash.
S3_KEY_PREFIX=softwares/
PRESIGN_TTL_SECONDS=3600

# ---- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=2147483648
# Files at/above this size use S3 multipart upload (min 5 MB)
MULTIPART_THRESHOLD_BYTES=104857600
MULTIPART_PART_SIZE_BYTES=8388608
MULTIPART_MAX_PARTS=10000
MULTIPART_SIGN_BATCH=50
# Browser-side upload tuning (sent to the UI)
UPLOAD_CONCURRENCY=4
UPLOAD_PART_RETRIES=3
HASH_CHUNK_BYTES=8388608
# Restrict uploadable/URL extensions (default: every extension listed in the presets file)
# ALLOWED_EXTENSIONS=exe,msi,zip,ps1,bat,cmd

# ---- Delivery to laptops ----------------------------------------------------
# URL Windows clients download from, i.e. ${BACKEND_BASE_URL}/softwares (shown in the UI)
PUBLIC_DOWNLOAD_BASE_URL=https://rms-api.example.org/softwares
# Serve /softwares/:file from this service by streaming from S3 (alternative to Nginx->S3)
ENABLE_DOWNLOAD_PROXY=false
DOWNLOAD_PROXY_PATH=softwares
# Allow plain http:// external script URLs (https is always allowed)
ALLOW_HTTP_EXTERNAL_URLS=false

# ---- Install scripts for deployed RMS clients (1.4.0) -----------------------
# For uploaded / URL software the portal generates a PowerShell install script that applies all
# parameters, stores it next to the installers and points winget_id at it. The 1.4.0 client runs
# any https://…/*.ps1 winget_id as an elevated script. Requires PUBLIC_DOWNLOAD_BASE_URL.
CLIENT_COMPAT_WRAPPER=true
WRAPPER_SOURCES=rms-repository,external_url
WRAPPER_FILE_PREFIX=rms-install-
WRAPPER_MUTEX_NAME=Global\RMSPortalInstall
WRAPPER_MUTEX_WAIT_MINUTES=20
WRAPPER_DOWNLOAD_RETRIES=3
# Where the 1.4.0 client caches its serial number (so reports match the right device)
WRAPPER_DEVICE_INFO_FILE=C:\System.ServiceData\device_info.json
WRAPPER_WORK_DIR=%ProgramData%\RMSPortal\work
WRAPPER_LOG_TAIL_LINES=80
# Detailed results (exit code, error, transcript) posted by scripts to POST /api/client/install-report.
# Set PORTAL_PUBLIC_URL (public https URL of this portal) or WRAPPER_TELEMETRY_URL; empty = off.
PORTAL_PUBLIC_URL=
# WRAPPER_TELEMETRY_URL=
# Embedded in scripts (public); only deters drive-by posts. openssl rand -hex 16
WRAPPER_REPORT_TOKEN=
WRAPPER_MAX_REPORT_LOG_CHARS=200000
WRAPPER_REPORT_RATE_WINDOW_MINUTES=15
WRAPPER_REPORT_RATE_MAX=600
# How a script report is matched to the client's history row (minutes before/after)
WRAPPER_REPORT_MATCH_BEFORE_MINUTES=180
WRAPPER_REPORT_MATCH_AFTER_MINUTES=30

# ---- Execution parameter limits (wizard + API validation) -------------------
TIMEOUT_MIN_MINUTES=2
TIMEOUT_MAX_MINUTES=30
TIMEOUT_DEFAULT_MINUTES=10
# Exit codes treated as success when a software doesn't set its own list
DEFAULT_SUCCESS_EXIT_CODES=0,3010,1641

# ---- Rollout ----------------------------------------------------------------
CANARY_MIN_DEVICES=1
CANARY_MAX_DEVICES=5
# Total automatic attempts for a failed install before an admin must click Retry
MAX_AUTO_RETRY_ATTEMPTS=3
MAX_RETRY_ATTEMPTS_CEILING=20
# Lower installs first (e.g. give your browser 0 so it lands before everything else)
INSTALL_PRIORITY_DEFAULT=100
INSTALL_PRIORITY_MAX=1000

# ---- Reporting --------------------------------------------------------------
HISTORY_PAGE_SIZE=50
HISTORY_MAX_PAGE_SIZE=200
EXPORT_MAX_ROWS=50000
DEVICE_SEARCH_LIMIT=20
AUDIT_LOG_LIMIT=100
ANALYTICS_DAILY_DAYS=14
ANALYTICS_ERROR_WINDOW_DAYS=30
ANALYTICS_TOP_ERRORS=5
ANALYTICS_RECENT_HOURS=24

# ---- Presets & diagnostics (data files) -------------------------------------
# Replace/extend installer presets, labels, exit-code hints and error patterns.
# PORTAL_PRESETS_FILE=./config/portal-presets.json
# Add or override individual exit codes: {"1234": {"severity":"error","title":"…","hint":"…"}}
# EXIT_CODE_HINTS_FILE=./config/exit-codes.local.json

# ---- Existing RMS table/column names ----------------------------------------
# Defaults match navgurukul/windows-rms-server (db/schema.js). Change only if your schema differs.
DONORS_TABLE=donors
DONORS_NAME_COLUMN=donor_name
NGOS_TABLE=NGOs
NGOS_NAME_COLUMN=NGO_name
DEVICES_TABLE=devices
DEVICES_SERIAL_COLUMN=serial_number
DEVICES_NGO_FK_COLUMN=ngo_id
DEVICES_DONOR_FK_COLUMN=donor_id
# Optional device columns (empty = not shown)
DEVICES_MODEL_COLUMN=
DEVICES_USERNAME_COLUMN=username
DEVICES_LOCATION_COLUMN=location
DEVICES_ACTIVE_COLUMN=isactive

# ---- Offline demo (npm run demo) --------------------------------------------
# DEMO_PORT=4000
# DEMO_USER=demo-admin
# DEMO_SEED_FILE=./demo/seed.json
