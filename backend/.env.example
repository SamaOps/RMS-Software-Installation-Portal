# RMS Software Portal: the only settings you need.
# Every other option has a sensible default; see docs/CONFIGURATION.md if you ever need to change one.

# The existing RMS PostgreSQL (same database windows-rms-server uses)
DATABASE_URL=postgres://user:password@host:5432/rms
DATABASE_SSL=true

# Public https URL of this portal that the laptops can reach (downloads + install reports)
PORTAL_PUBLIC_URL=https://software.example.org

# Login: a random 32+ character secret (openssl rand -hex 32), and admins from:
#   npm run hash-password -- <username> '<password>'   (comma-separate several)
JWT_SECRET=
ADMIN_USERS=

# Optional: store files in S3/R2 instead of this server's disk
# S3_BUCKET=
# S3_REGION=ap-south-1

# Optional: windows-rms-server REST API integration
# RMS_SERVER_API_URL=http://localhost:3000
# RMS_SERVER_API_KEY=
# RMS_SERVER_AUTH_ENABLED=false

