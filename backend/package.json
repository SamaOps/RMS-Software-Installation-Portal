{
  "name": "rms-software-portal-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Admin API for uploading, configuring and distributing software to RMS-managed Windows laptops",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "demo": "node demo-server.js",
    "migrate": "node scripts/migrate.js",
    "hash-password": "node scripts/hash-password.js",
    "import-legacy": "node scripts/import-legacy-files.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "publish-scripts": "node scripts/publish-client-scripts.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  }
}
